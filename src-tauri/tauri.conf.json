{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DKOOs JARVIS",
  "version": "0.1.0",
  "identifier": "ai.dkoo.jarvis",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [{
      "title": "DKOOs JARVIS",
      "width": 1440,
      "height": 900,
      "minWidth": 1060,
      "minHeight": 720,
      "center": true,
      "decorations": true,
      "transparent": false
    }],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; font-src 'self'; media-src 'self' blob: asset: http://asset.localhost",
      "capabilities": ["main"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "DeveloperTool",
    "shortDescription": "Local-first AI engineering assistant",
    "longDescription": "A permission-gated engineering command center with optional local wake-word voice control.",
    "resources": {
      "binaries/jarvis-wakeword": "binaries/jarvis-wakeword"
    },
    "macOS": {
      "minimumSystemVersion": "12.0",
      "entitlements": "Entitlements.plist",
      "infoPlist": "Info.plist"
    }
  }
}
